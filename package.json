{
  "name": "vue-plugin-kuzzle",
  "version": "4.8.0-vue3.1",
  "description": "A Vue.js plugin shipping the Kuzzle SDK in your components",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run test:lint && npm run test:types && npm run test:unit",
    "test:lint": "eslint .",
    "test:lint:fix": "eslint . --fix",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzzleio/vue-plugin-kuzzle.git"
  },
  "keywords": [
    "kuzzle",
    "vuejs",
    "plugin"
  ],
  "author": "Luca Marchesini <luca@kuzzle.io>",
  "license": "Apache 2",
  "bugs": {
    "url": "https://github.com/kuzzleio/vue-plugin-kuzzle/issues"
  },
  "homepage": "https://github.com/kuzzleio/vue-plugin-kuzzle#readme",
  "peerDependencies": {
    "kuzzle-sdk": "^7.18.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-kuzzle": "^2.0.0",
    "jsdom": "^29.1.1",
    "kuzzle-sdk": "^7.18.0",
    "semantic-release-config-kuzzle": "1.8.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.44"
  },
  "files": [
    "dist"
  ]
}
